# Life Manager MCP server — environment
#
# The server authenticates against life-api as YOU (a real Life Manager user login),
# not a dedicated service account. Everything Claude creates then lands on your own
# account, and you assign/share it to the family with the app's existing sharing.

# Base URL of a running life-api instance.
LM_API_BASE_URL=http://localhost:5000

# Your Life Manager login (email or username) and password.
LM_MCP_EMAIL=you@example.com
LM_MCP_PASSWORD=

# Optional — User-Agent sent on every API call (shows in the life-api audit log).
# LM_MCP_USER_AGENT=LifeManager-MCP/1.0

# Optional — base URL of a running finance-api instance. Enables the finance_* tools.
# No separate email/password needed: finance-api has no login of its own, it validates
# the same JWT life-api issues (same Jwt:Secret), so your LM_MCP_EMAIL/PASSWORD login
# already works for it too. Leave unset and finance_* tools are simply not registered.
# FIN_API_BASE_URL=http://localhost:5002
